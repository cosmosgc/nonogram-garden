{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "useDefineForClassFields": true,
    "skipLibCheck": true,
    "types": ["vite/client", "vitest/globals"],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["resources/js/**/*.ts", "resources/js/**/*.vue", "vite.config.js"]
}
